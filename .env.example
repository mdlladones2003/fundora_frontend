# Rust Axum backend. API_BASE_URL should include /api/v1.
VITE_API_BASE_URL=/api/v1

# Set true only when the backend uses cross-origin HttpOnly cookies.
VITE_USE_CREDENTIALS=false

# Configure matching Google OAuth client IDs in the frontend and backend.
# Add the exact frontend origin (for example, http://localhost:5173) to the
# OAuth client's Authorized JavaScript origins in Google Cloud Console.
VITE_GOOGLE_CLIENT_ID=903726533782-e93k4cvl9l84s4619tnndcrrao8pqt02.apps.googleusercontent.com

# Configure an Apple Services ID and a registered redirect URL.
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=
